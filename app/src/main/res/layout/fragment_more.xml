<?xml version="1.0" encoding="utf-8"?>
<!-- YTindr: sade "Daha fazla" ekranı - logo başlığı ve yuvarlak köşeli gruplar -->
<androidx.core.widget.NestedScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/app_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_app_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView style="@style/YTindr.MoreCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/downloads"
                    style="@style/YTindr.MoreRow"
                    android:text="@string/downloads"
                    app:drawableStartCompat="@drawable/ic_downloads" />
                <View android:id="@+id/more_divider_1" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="60dp" android:background="?attr/colorOutlineVariant" android:alpha="0.5"/>
                <TextView
                    android:id="@+id/download_queue"
                    style="@style/YTindr.MoreRow"
                    android:text="@string/download_queue"
                    app:drawableStartCompat="@drawable/baseline_downloading_24" />
                <View android:id="@+id/more_divider_2" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="60dp" android:background="?attr/colorOutlineVariant" android:alpha="0.5"/>
                <TextView
                    android:id="@+id/cookies"
                    style="@style/YTindr.MoreRow"
                    android:text="@string/cookies"
                    app:drawableStartCompat="@drawable/baseline_cookie_24" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="60dp" android:background="?attr/colorOutlineVariant" android:alpha="0.5"/>
                <TextView
                    android:id="@+id/logs"
                    style="@style/YTindr.MoreRow"
                    android:text="@string/logs"
                    app:drawableStartCompat="@drawable/ic_baseline_file_open_24" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/YTindr.MoreCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/settings"
                    style="@style/YTindr.MoreRow"
                    android:text="@string/settings"
                    app:drawableStartCompat="@drawable/ic_settings" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="60dp" android:background="?attr/colorOutlineVariant" android:alpha="0.5"/>
                <TextView
                    android:id="@+id/terminate"
                    style="@style/YTindr.MoreRow"
                    android:text="@string/kill_app"
                    app:drawableStartCompat="@drawable/ic_power" app:drawableTint="?attr/colorError"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Gizli özellikler: kod bu kimliklere hâlâ başvurduğu için görünmez tutuluyor -->
        <TextView android:id="@+id/terminal" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/command_templates" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/observe_sources" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
