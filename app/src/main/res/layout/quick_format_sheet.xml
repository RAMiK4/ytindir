<?xml version="1.0" encoding="utf-8"?>
<!-- YTindir: the quick download card's choices: video qualities, audio only and the thumbnail,
     under the title of what is being downloaded, with a progress bar while its data is read -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/quick_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <TextView
        android:id="@+id/quick_sheet_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="24dp"
        android:paddingTop="2dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/quick_sheet_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackCornerRadius="2dp" />

    <!-- weight: a long list scrolls and the buttons under it stay on screen -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/quick_format_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

    </androidx.core.widget.NestedScrollView>

    <!-- YTindir: All options closes the list and shows the download card with all its options, Download
         (on the right) starts the download with the marked choice. The icons stay next to the text.
         Explicit styles: the app's theme draws plain buttons as text buttons -->
    <LinearLayout
        android:id="@+id/quick_sheet_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quick_sheet_all_options"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="10dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:text="@string/quick_all_options"
            app:icon="@drawable/ic_format_list"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconPadding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quick_sheet_download"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="10dp"
            android:maxLines="1"
            android:textSize="13sp"
            android:text="@string/download"
            app:icon="@drawable/baseline_download_24"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconPadding="8dp" />

    </LinearLayout>

</LinearLayout>
