<?xml version="1.0" encoding="utf-8"?>
<!-- YTindir: about, a settings section of its own -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:icon="@drawable/ic_update"
        app:key="app_version"
        app:title="@string/version" />

    <Preference
        app:icon="@drawable/baseline_exit_to_app_24"
        app:key="package_name"
        app:title="@string/package_name" />

    <Preference
        app:icon="@drawable/ic_code"
        app:key="ytindir_project"
        app:summary="github.com/RAMiK4/ytindir"
        app:title="YTindir (by Ramik ☆)">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/RAMiK4/ytindir" />
    </Preference>

    <Preference
        app:icon="@drawable/baseline_star_half_24"
        app:key="powered_by"
        app:selectable="false"
        app:summary="YTDLnis · yt-dlp"
        app:title="@string/powered_by" />

    <Preference
        app:icon="@drawable/ic_license"
        app:key="license"
        app:summary="GNU General Public License v3.0"
        app:title="@string/license">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/RAMiK4/ytindir/blob/main/LICENSE" />
    </Preference>

</PreferenceScreen>
