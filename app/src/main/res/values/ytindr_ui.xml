<?xml version="1.0" encoding="utf-8"?>
<!-- YTindir: yüzen cam alt menü ve liste kartları -->
<resources>
    <color name="ytindr_nav_bg">#E6FFFFFF</color>
    <color name="ytindr_nav_stroke">#1A000000</color>
    <!-- YTindir: the nav's tint over the blurred content behind it (Android 12+), and its light edge -->
    <color name="ytindr_nav_glass">#A6FFFFFF</color>
    <color name="ytindr_nav_glass_stroke">#26000000</color>
    <item name="ytindr_nav_padded" type="id"/>
    <!-- YTindir: the bottom nav's chosen item: a faint neutral capsule, no green -->
    <color name="ytindr_nav_indicator">#0F000000</color>
    <style name="YTindir.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">52dp</item>
        <item name="android:height">28dp</item>
        <item name="android:color">@color/ytindr_nav_indicator</item>
        <item name="shapeAppearance">@style/YTindir.Shape.Pill</item>
    </style>
    <style name="YTindir.Shape.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="YTindir.Shape.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="YTindir.Shape.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="YTindir.Shape.Format" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="YTindir.TabText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- YTindir: ana sayfa başlığındaki logo -->
    <style name="YTindir.LogoTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">25sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="fontFamily">@font/ytindr_logo</item>
        <item name="android:fontFamily">@font/ytindr_logo</item>
    </style>
    <!-- YTindir: alt menü etiketleri kapsülün içinde kalsın -->
    <style name="YTindir.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="YTindir.NavLabel.Active">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="YTindir.Shape.Field" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <!-- YTindir: indirme kartındaki bölüm başlıkları -->
    <style name="YTindir.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <color name="ytindr_backdrop_scrim">#B8F0F0F0</color>
    <!-- YTindir: diyaloglar - nötr koyu yüzey, ince çerçeve, kalın başlık, yeşil vurgu -->
    <style name="ThemeOverlay.YTindir.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="elevationOverlayEnabled">false</item>
        <!-- the dialog's own surface; also keeps it visible in the pure black (high contrast) theme -->
        <item name="colorSurface">?attr/colorSurfaceContainerHigh</item>
        <item name="android:colorBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="materialAlertDialogTitleTextStyle">@style/YTindir.DialogTitle</item>
        <item name="shapeAppearanceOverlay">@style/YTindir.Shape.Dialog</item>
    </style>
    <style name="YTindir.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="YTindir.Shape.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
</resources>
