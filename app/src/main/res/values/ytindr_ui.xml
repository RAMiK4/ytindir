<?xml version="1.0" encoding="utf-8"?>
<!-- YTindr: yüzen cam alt menü ve liste kartları -->
<resources>
    <color name="ytindr_nav_bg">#E6FFFFFF</color>
    <color name="ytindr_nav_stroke">#1A000000</color>
    <item name="ytindr_nav_padded" type="id"/>

    <style name="YTindr.Shape.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="YTindr.Shape.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="YTindr.Shape.Format" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="YTindr.TabText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- YTindr: ana sayfa başlığındaki logo -->
    <style name="YTindr.LogoTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">25sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="fontFamily">@font/ytindr_logo</item>
        <item name="android:fontFamily">@font/ytindr_logo</item>
    </style>
    <!-- YTindr: alt menü etiketleri kapsülün içinde kalsın -->
    <style name="YTindr.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="YTindr.NavLabel.Active">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="YTindr.Shape.Field" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <!-- YTindr: indirme kartındaki bölüm başlıkları -->
    <style name="YTindr.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>
